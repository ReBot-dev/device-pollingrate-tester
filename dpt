import sys

try:
    line = input()
    before = float(line)
except ValueError:
    print("int error!")
now = 0
deltax = 0
for line in sys.stdin:
    try: 
        now = float(line)
        deltax = float(now - before)
        print(deltax)
        before = now
    except ValueError:
        print("stdin error!")
